rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    // Public catalog. All sensitive writes go through trusted server routes.
    match /products/{productId} {
      allow get, list: if resource.data.status == 'active';
      allow create, update, delete: if false;

      match /inventory/{itemId} {
        allow read, write: if false;
      }
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create, update, delete: if false;

      match /orders/{orderId} {
        allow get, list: if owner(uid);
        allow write: if false;
      }
      match /transactions/{transactionId} {
        allow get, list: if owner(uid);
        allow write: if false;
      }
      match /notifications/{notificationId} {
        allow get, list: if owner(uid);
        allow write: if false;
      }
      match /favorites/{productId} {
        allow get, list: if owner(uid);
        allow write: if false;
      }
    }

    match /orders/{orderId} { allow read, write: if false; }
    match /deliveries/{deliveryId} { allow read, write: if false; }
    match /deposits/{depositId} { allow read, write: if false; }
    match /vouchers/{voucherId} { allow read, write: if false; }
    match /providerEvents/{eventId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
